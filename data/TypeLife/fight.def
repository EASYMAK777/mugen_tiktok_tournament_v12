;-----------------------------------------------------------
[WinIcon]
p1.pos = 495,84
p2.pos = 749,84
; Offset for next icon (x,y)
p1.iconoffset = 34,0  
p2.iconoffset = -34,0
; Counter text font and offset for representing wins
p1.counter.offset = 0,0
p1.counter.font = 2,1
p1.counter.scale = 1,1
p2.counter.offset = 0,0
p2.counter.font = 2,1
p2.counter.scale = 1,1
; Win by normal
p1.n.spr = 100,0
p1.n.scale = 1,1
p2.n.spr = 100,0
p2.n.scale =  1,1
p2.n.facing = 1
; Win by special
p1.s.spr = 101,0
p1.s.scale =  1,1
p2.s.spr = 101,0
p2.s.scale =  1,1
p2.s.facing = 1
; Win by hyper (super)
p1.h.spr = 101,0
p1.h.scale =  1,1
p2.h.spr = 101,0
p2.h.scale =  1,1
p2.h.facing = 1
; Win by normal throw
p1.throw.spr = 100,0
p1.throw.scale =  1,1
p2.throw.spr = 100,0
p2.throw.scale =  1,1
p2.throw.facing = 1
; Win by cheese
p1.c.spr = 100,0
p1.c.scale =  1,1
p2.c.spr = 100,0
p2.c.scale =  1,1
p2.c.facing = 1
; Win by time over
p1.t.spr = 103,0
p1.t.scale =  1,1
p2.t.spr = 103,0
p2.t.scale =  1,1
p2.t.facing = 1
; Win by suicide (here's a fun one)
p1.suicide.spr = 100,0
p1.suicide.scale =  1,1
p2.suicide.spr = 100,0
p2.suicide.scale =  1,1
p2.suicide.facing = 1
; Opponent beaten by his own teammate (another fun one)
p1.teammate.spr = 100,0
p1.teammate.scale =  1,1
p2.teammate.spr = 100,0
p2.teammate.scale =  1,1
p2.teammate.facing = 1
; Win by perfect (overlay icon)
p1.perfect.spr = 102,0
p1.perfect.scale =  1,1
p2.perfect.spr = 102,0
p2.perfect.scale = 1,1
p2.perfect.facing = 1
; Use icons up until this number of wins
useiconupto = 4
