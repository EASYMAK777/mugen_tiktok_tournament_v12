[Constants]
;-----------------------------------------------------------------------------------------
; ###################### constants for STICK  #############################
;-----------------------------------------------------------------------------------------
----------------------configure------
##1/on 0/off buttons
#top row >>>>left to right
showx 	 = 1
showy	 = 1
showz 	 = 1
showtagsf = 1
#bottom row >>>>left to right
showa 	 = 1
showb  	 = 1
showc	 = 1
showtagsb = 1
#start button
showstart =1
;--------------button press delay 6-------------------

buttondelay = 6 ; 6 frame default before button resets position

;#------------------button animations------------
;# included some colours on dif anims	
;# white  = 43,42
;# blue   = 45,44
;# red    = 47,46
;# green  = 49,48
;# brown  = 51,50
;# purple = 53,52
;# orange = 55,54
;# cyan   = 57,56
;# yellow = 59,58
;# pink   = 61,60

#top row  >>>>left to right
cnx   = 46
cnxd  = 47
cny   = 48
cnyd  = 49
cnz   = 50
cnzd  = 51
cnt1  = 52
cnt1d = 53
#bottom row >>>>left to right
cna   = 40	
cnad  = 41	
cnb   = 42
cnbd  = 43
cnc   = 44
cncd  = 45
cnt2  = 54 
cnt2d = 55 
#start button
cnst  = 56
cnstd = 57



