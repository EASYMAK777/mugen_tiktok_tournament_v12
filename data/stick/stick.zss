#===============================================================================
#Stick helper
#===============================================================================
 [Statedef 45991100; type: S; movetype: I; physics: N;
 anim: ARSTK 999; sprpriority: -4; ctrl: 0; poweradd:0; juggle:0; ]

notHitBy{value: SCA; time: -1}
#-> setting maps
ignoreHitPause if roundstate != 0 {
if root,map(xy) = 0{root,map(xy):= (screenheight/180);}
if root,map(buttondelay) <1 {root,map(buttondelay):=root,const(buttondelay);}
if root,command="holdback" {root,map(commandmap):= 1;}
if root,command="holdfwd" {root,map(commandmap):= 2;}
if root,command="holdup" {root,map(commandmap):= 3;}
if root,command="holddown" {root,map(commandmap):= 4;}
if root,command="holdback" && root,command="holdup" {root,map(commandmap):= 10;}
if root,command="holdfwd" && root,command="holdup" {root,map(commandmap):= 11;}
if root,command="holdback" && root,command="holddown" {root,map(commandmap):= 20;}
if root,command="holdfwd" && root,command="holddown" {root,map(commandmap):= 21;}
if root,command!="holdfwd" && root,command!="holdback" && root,command!="holdup" && root,command!="holddown"{root,map(commandmap):= 0;}
if root,command="x" {root,map(commandx):= root,map(buttondelay);}
if root,command="holdx" {root,map(commandx):= root,map(buttondelay);}
if root,command="y" {root,map(commandy):= root,map(buttondelay);}
if root,command="holdy" {root,map(commandy):= root,map(buttondelay);}
if root,command="z" {root,map(commandz):= root,map(buttondelay);}
if root,command="holdz" {root,map(commandz):= root,map(buttondelay);}
if root,command="a" {root,map(commanda):= root,map(buttondelay);}
if root,command="holda" {root,map(commanda):= root,map(buttondelay);}
if root,command="b" {root,map(commandb):= root,map(buttondelay);}
if root,command="holdb" {root,map(commandb):= root,map(buttondelay);}
if root,command="c" {root,map(commandc):= root,map(buttondelay);}
if root,command="holdc" {root,map(commandc):= root,map(buttondelay);}
if root,command="TagShiftBack" {root,map(commandShiftBack):= root,map(buttondelay);}
if root,command="holdTagShiftBack" {root,map(commandShiftBack):= root,map(buttondelay);}
if root,command="TagShiftFwd" {root,map(commandShiftFwd):= root,map(buttondelay);}
if root,command="holdTagShiftFwd" {root,map(commandShiftFwd):= root,map(buttondelay);}
if root,command="start" {root,map(commandstart):= root,map(buttondelay);}
if root,command="holdstart" {root,map(commandstart):= root,map(buttondelay);}

#-> stick
	ignoreHitPause if numExplod(888770) <2{
	removeexplod{id:888770;}
	explod{id:888770; anim:ARSTK 
		 Cond(root,map(commandmap)=1,Cond(root,facing=1,33,34), ##back
		 Cond(root,map(commandmap)=2 ,Cond(root,facing=1,34,33), #forward
		 Cond(root,map(commandmap)=3 ,38,#up
		 Cond(root,map(commandmap)=4 ,32,#down
		 Cond(root,map(commandmap)=10 ,Cond(root,facing=1,36,37),#up bk
		 Cond(root,map(commandmap)=11 ,Cond(root,facing=1,37,36),#up frwd
		 Cond(root,map(commandmap)=20 ,Cond(root,facing=1,30,31),#down bk
		 Cond(root,map(commandmap)=21 ,Cond(root,facing=1,31,30),#down frwd
		 Cond(root,map(commandmap)=0 ,35,#reset

		   
		 35))))))))); postype: left; space: screen; pos: 120, (83*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0; } 
	}
	


#-> buttons
#-> x
	ignoreHitPause if numExplod(888870) <2 && const(showx) = 1{
	explod{id:888870; anim:ARSTK 
		 Cond(root,map(commandx)>0,const(cnx), 
		   
		 const(cnxd)); postype: left; space: screen; pos: 140, (87*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}

#-> y
	ignoreHitPause if numExplod(888871) <2 && const(showy) = 1{
	explod{id:888871; anim:ARSTK 
		 Cond(root,map(commandy)>0,const(cny), 
		   
		 const(cnyd)); postype: left; space: screen; pos: 156+cond(root,map(xy) !=1,5,0), (87*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}

#-> z
	ignoreHitPause if numExplod(888872) <2 && const(showz) = 1{
	explod{id:888872; anim:ARSTK 
		 Cond(root,map(commandz)>0,const(cnz), 
		   
		 const(cnzd)); postype: left; space: screen; pos: 172+cond(root,map(xy) !=1,10,0), (87*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}
	
#-> commandShiftFwd
	ignoreHitPause if numExplod(888877) <2 && const(showtagsf) = 1{
	explod{id:888877; anim:ARSTK 
		 Cond(root,map(commandShiftFwd)>0,const(cnt2), 
		   
		 const(cnt2d)); postype: left; space: screen; pos: 185+cond(root,map(xy) !=1,15,0), (87*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0} 
	}


#-> a
	ignoreHitPause if numExplod(888874) <2 && const(showa) = 1{
	explod{id:888874; anim:ARSTK 
		 Cond(root,map(commanda)>0,const(cna), 
		   
		 const(cnad)); postype: left; space: screen; pos: 140, (75*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}

#-> b
	ignoreHitPause if numExplod(888875) <2 && const(showb) = 1{
	explod{id:888875; anim:ARSTK 
		 Cond(root,map(commandb)>0,const(cnb), 
		   
		 const(cnbd)); postype: left; space: screen; pos: 156+cond(root,map(xy) !=1,5,0), (75*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}

#-> c
	ignoreHitPause if numExplod(888876) <2 && const(showc) = 1{
	explod{id:888876; anim:ARSTK 
		 Cond(root,map(commandc)>0,const(cnc), 
		   
		 const(cncd)); postype: left; space: screen; pos: 172+cond(root,map(xy) !=1,10,0), (75*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}
	
#-> commandShiftBack
	ignoreHitPause if numExplod(888873) <2 && const(showtagsb) = 1{
	explod{id:888873; anim:ARSTK 
		 Cond(root,map(commandShiftBack)>0,const(cnt1), 
		   
		 const(cnt1d)); postype: left; space: screen; pos: 185+cond(root,map(xy) !=1,15,0), (75*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0;} 
	}
	

	
#-> commandstart
	ignoreHitPause if numExplod(888878) <2 && const(showstart) = 1{
	explod{id:888878; anim:ARSTK 
		 Cond(root,map(commandstart)>0,const(cnst), 
		   
		 const(cnstd)); postype: left; space: screen; pos: 198+cond(root,map(xy) !=1,20,0), floor(81*root,map(xy)); velocity: 0, 0; accel: 0, 0; removetime: 1;scale:1,1;under:0;ontop:1; superMoveTime: 0; pauseMoveTime: 0} 
	}
	

}

		
if root,!alive || root,playerno != teamLeader {
   destroySelf{}
}
 
 
####################################################
[statedef +1] 
#-> helper spawn on teamleader
ignoreHitPause if roundstate != 0 && teamside = 1 && playerno = teamLeader && gamemode = "training" {
ignoreHitPause if !numhelper(45991100) && alive{
helper{helpertype: normal; name:"stick"; stateno:45991100; id:45991100;	postype: p1; pos: -1000, -1000; superMoveTime:999; pauseMoveTime:999; }
}
#-----------------------------------------



#-> reset map cooldown
ignorehitpause if map(commandx) > 0 {mapadd{map:"commandx";value:-1}}	
ignorehitpause if map(commandy) > 0 {mapadd{map:"commandy";value:-1}}	
ignorehitpause if map(commandz) > 0 {mapadd{map:"commandz";value:-1}}	
ignorehitpause if map(commanda) > 0 {mapadd{map:"commanda";value:-1}}	
ignorehitpause if map(commandb) > 0 {mapadd{map:"commandb";value:-1}}	
ignorehitpause if map(commandc) > 0 {mapadd{map:"commandc";value:-1}}	
ignorehitpause if map(commandShiftBack) > 0 {mapadd{map:"commandShiftBack";value:-1}}	
ignorehitpause if map(commandShiftFwd) > 0 {mapadd{map:"commandShiftFwd";value:-1}}	
ignorehitpause if map(commandstart) > 0 {mapadd{map:"commandstart";value:-1}}	
	}